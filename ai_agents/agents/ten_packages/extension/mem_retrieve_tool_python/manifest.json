{
  "type": "extension",
  "name": "mem_retrieve_tool_python",
  "version": "0.11.52",
  "display_name": {
    "locales": {
      "en-US": {
        "content": "Memory Retrieve Tool"
      },
      "zh-CN": {
        "content": "记忆检索工具"
      }
    }
  },
  "description": {
    "locales": {
      "en-US": {
        "content": "A tool extension for retrieving relevant memory and context from Zep Cloud based on user queries"
      },
      "zh-CN": {
        "content": "基于用户查询从 Zep Cloud 检索相关记忆和上下文的工具扩展"
      }
    }
  },
  "tags": [
    "python",
    "memory",
    "zep",
    "tool"
  ],
  "dependencies": [
    {
      "type": "system",
      "name": "ten_runtime_python",
      "version": "0.11.52"
    }
  ],
  "package": {
    "include": [
      "manifest.json",
      "property.json",
      "pyproject.toml",
      "tests/**.py",
      "tests/pyproject.toml",
      "tests/bin/*",
      "requirements.txt",
      "docs/**",
      ".vscode/**",
      "**.py"
    ]
  },
  "api": {
    "property": {
      "properties": {
        "zep_api_key": {
          "type": "string",
          "description": "Zep Cloud API key"
        },
        "user_id": {
          "type": "string",
          "description": "User ID for memory retrieval"
        },
        "agent_id": {
          "type": "string",
          "description": "Agent ID for memory retrieval"
        }
      }
    },
    "cmd_in": [
      {
        "name": "tool_call",
        "property": {
          "properties": {
            "name": {
              "type": "string"
            },
            "args": {
              "type": "string"
            }
          },
          "required": [
            "name"
          ]
        }
      }
    ],
    "cmd_out": [
      {
        "name": "tool_register",
        "property": {
          "properties": {
            "tool": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "parameters": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {}
                  }
                }
              },
              "required": [
                "name",
                "description",
                "parameters"
              ]
            }
          }
        },
        "result": {
          "property": {
            "properties": {
              "response": {
                "type": "string"
              }
            }
          }
        }
      }
    ]
  },
  "scripts": {
    "test": "tests/bin/start"
  }
}
